#!/bin/sh
set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)
  LINK=$(readlink "$SOURCE")
  case "$LINK" in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$SOURCE_DIR/$LINK ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)
exec "$SCRIPT_DIR/src/drift.sh" "$@"
