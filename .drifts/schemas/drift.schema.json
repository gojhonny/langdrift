{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LangDrift Drift Manifest (draft 0.1)",
  "description": "Portable initiative progress and artifact references. Not document approval or a runtime configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "project",
    "initiatives",
    "activity"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "schemas/drift.schema.json"
    },
    "schemaVersion": {
      "const": "0.1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "initiatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/initiative"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "intake",
            "research",
            "prd",
            "design",
            "technical-design",
            "spec",
            "adr",
            "ticket",
            "handoff",
            "delivery",
            "experiment"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.md$",
          "description": "Repository-root-relative Markdown path; adapters must also resolve symlinks and check containment."
        }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "owner",
        "artifacts",
        "pendingDependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "owner": {
          "$ref": "#/$defs/actor"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "pendingDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initiativeId",
        "actor",
        "action",
        "occurredAt",
        "summary",
        "artifactIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "initiativeId": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "action": {
          "enum": [
            "artifact.drafted",
            "artifact.updated",
            "implementation.recorded",
            "verification.recorded",
            "dependency.recorded"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
