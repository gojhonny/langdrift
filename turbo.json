{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env*"],
  "globalPassThroughEnv": [
    "CI",
    "NEXT_TELEMETRY_DISABLED",
    "NODE_OPTIONS",
    "NEXT_PUBLIC_DASHBOARD_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PUBLIC_SSO_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_WEBSITE_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "VERCEL_ENV",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "XDG_CACHE_HOME",
    "EMAIL_SERVICE_URL",
    "EMAIL_SERVICE_API_KEY",
    "EARLY_ACCESS_MODE",
    "TURNSTILE_SECRET_KEY",
    "TURNSTILE_EXPECTED_HOSTNAME",
    "TURNSTILE_VERIFY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@repo/react#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@repo/design-tokens#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@langdrift/setup#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/_pagefind/**"]
    }
  },
  "globalEnv": ["NEXT_PUBLIC_*", "VERCEL_ENV"]
}
