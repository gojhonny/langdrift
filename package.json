{
  "name": "langdrift",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "postinstall": "./cli/drift setup --postinstall",
    "prepare": "./cli/drift git setup --prepare",
    "postclone": "./cli/drift setup --postclone",
    "drift": "./cli/drift",
    "dev": "turbo dev --filter=website --filter=console --filter=sso --filter=mobile",
    "start": "turbo start --filter=website --filter=console --filter=sso --filter=mobile",
    "build": "turbo run build",
    "lint": "biome lint . --files-ignore-unknown=true",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc}": [
      "biome lint --write --files-ignore-unknown=true",
      "biome format --write --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
