{
  "name": "langdrift",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "drift": "./cli/drift",
    "build": "turbo run build",
    "lint": "biome lint . --files-ignore-unknown=true",
    "typecheck": "turbo run typecheck",
    "test:early-access": "vitest run --config vitest.config.mts",
    "coverage:early-access": "vitest run --config vitest.config.mts --coverage",
    "website": "./cli/drift dev website",
    "docs": "./cli/drift dev docs",
    "sso": "./cli/drift dev sso",
    "dashboard": "./cli/drift dev dashboard",
    "mobile": "./cli/drift dev mobile",
    "showcase": "./cli/drift showcase",
    "prepare": "husky cli/.husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@testing-library/react": "16.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^15.5.1",
    "turbo": "^2.8.16",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc}": [
      "biome lint --write --files-ignore-unknown=true",
      "biome format --write --files-ignore-unknown=true"
    ]
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1",
      "sharp": "0.35.4",
      "postcss": "8.5.28",
      "@xmldom/xmldom": "0.9.12",
      "nextra@4.6.1>zod": "4.3.6",
      "nextra-theme-docs@4.6.1>zod": "4.3.6"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
