{
  "name": "langdrift",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "drift": "./cli/drift",
    "build": "turbo run build",
    "lint": "biome lint . --files-ignore-unknown=true",
    "typecheck": "turbo run typecheck",
    "website": "./cli/drift dev website",
    "sso": "./cli/drift dev sso",
    "console": "./cli/drift dev console",
    "mobile": "./cli/drift dev mobile",
    "showcase": "./cli/drift showcase",
    "prepare": "husky cli/.husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc}": [
      "biome lint --write --files-ignore-unknown=true",
      "biome format --write --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
